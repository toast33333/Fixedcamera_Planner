<launch>
  <!-- Headless RK3588 field detector.  The model path is resolved from the
       installed ROS package, so the workspace does not have to belong to a
       user named firefly. -->
  <arg name="camera_id" default="$(optenv FIELD_CAMERA_ID 40)" />
  <arg name="frame_width" default="$(optenv FIELD_FRAME_WIDTH 640)" />
  <arg name="frame_height" default="$(optenv FIELD_FRAME_HEIGHT 480)" />
  <arg name="request_fps" default="$(optenv FIELD_REQUEST_FPS 60)" />
  <arg name="model_path" default="$(find detection_msgs)/rknnModel/yolov8-NewDrone.rknn" />
  <arg name="tpes" default="$(optenv FIELD_RKNN_TPES 3)" />
  <arg name="detection_topic" default="/object_detections" />
  <arg name="frame_id" default="camera_optical" />
  <arg name="enable_monitor_stream" default="$(optenv FIELD_ENABLE_MONITOR_STREAM 0)" />
  <arg name="monitor_port" default="$(optenv FIELD_MONITOR_PORT 8080)" />
  <arg name="monitor_fps" default="$(optenv FIELD_MONITOR_FPS 10)" />

  <node pkg="detection_msgs"
        type="ros1Main_aegis_stream.py"
        name="field_yolo_detector"
        output="screen"
        respawn="false">
    <param name="camera_id" value="$(arg camera_id)" />
    <param name="frame_width" value="$(arg frame_width)" />
    <param name="frame_height" value="$(arg frame_height)" />
    <param name="request_fps" value="$(arg request_fps)" />
    <param name="model_path" value="$(arg model_path)" />
    <param name="tpes" value="$(arg tpes)" />
    <param name="detection_topic" value="$(arg detection_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="direct_stream" value="$(arg enable_monitor_stream)" />
    <param name="direct_stream_port" value="$(arg monitor_port)" />
    <param name="stream_fps" value="$(arg monitor_fps)" />
    <param name="publish_ros_image" value="0" />
  </node>
</launch>
