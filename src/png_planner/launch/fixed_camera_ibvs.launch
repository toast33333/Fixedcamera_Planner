<launch>
  <arg name="config" default="$(find png_planner)/config/fixed_camera_ibvs.yaml" />
  <arg name="core_tuning_config" default="$(find png_planner)/config/core_tuning.yaml" />
  <arg name="detection_mode" default="1" />
  <arg name="detection_topic" default="/object_detections" />
  <arg name="enable_horizontal_control" default="true" />
  <arg name="enable_height_control" default="true" />
  <arg name="enable_camera_pitch_servo" default="false" />
  <arg name="forward_speed_mps" default="5.0" />
  <arg name="lost_forward_speed_mps" default="5.0" />

  <!--
    Always start the complete camera-pitch path with both hardware gates OFF.
    Merely starting this launch file never exports/enables the RK3576 PWM.
    The field script performs the explicit two-gate handshake only when
    SERVO_HARDWARE_AUTO_ARM=1 is requested by the operator.
  -->
  <include file="$(find png_planner)/launch/camera_pitch_servo_hardware.launch">
    <arg name="config" value="$(arg core_tuning_config)" />
  </include>

  <node pkg="png_planner"
        type="fixed_camera_ibvs"
        name="fixed_camera_ibvs"
        output="screen">
    <rosparam command="load" file="$(arg config)" />
    <rosparam command="load" file="$(arg core_tuning_config)" />
    <param name="detection_mode" value="$(arg detection_mode)" />
    <param name="detection_topic" value="$(arg detection_topic)" />
    <param name="enable_horizontal_control" value="$(arg enable_horizontal_control)" />
    <param name="enable_height_control" value="$(arg enable_height_control)" />
    <param name="enable_camera_pitch_servo" value="$(arg enable_camera_pitch_servo)" />
    <param name="V_default" value="$(arg forward_speed_mps)" />
    <param name="lost_forward_speed" value="$(arg lost_forward_speed_mps)" />
  </node>
</launch>
